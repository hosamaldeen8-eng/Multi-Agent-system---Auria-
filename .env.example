# ==========================================================================
# Auria Multi-Agent Fleet — configuration
# Copy to `.env` and fill in. Never commit the real .env.
# ==========================================================================

# --- Claude / Anthropic -------------------------------------------------
# The Agent SDK reads ANTHROPIC_API_KEY from the environment.
ANTHROPIC_API_KEY=sk-ant-...

# Model each tier uses. Orchestrator + reviewer default to Opus; the SDK
# also accepts aliases: fable | opus | sonnet | haiku | inherit.
AURIA_ORCHESTRATOR_MODEL=claude-opus-4-8
AURIA_WORKER_MODEL=sonnet
AURIA_REVIEWER_MODEL=opus

# Reasoning effort for the orchestrator: low | medium | high | xhigh | max
AURIA_EFFORT=high

# --- Unified memory -----------------------------------------------------
# Two options for the shared brain (memories, activity/chat log, tasks):
#
# 1) Hosted Postgres / Supabase (durable, shared) — set AURIA_DB_URL. The
#    `auria` schema + tables are already provisioned in the Supabase project.
#    Get the password from Supabase: Project Settings -> Database ->
#    Connection string (or "Reset database password"). Then:
# AURIA_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.lxuuapitmxjwbbmsrehj.supabase.co:5432/postgres
#
# 2) Local SQLite (zero-config default) — used only when AURIA_DB_URL is unset.
AURIA_DB_PATH=./data/auria_memory.db

# --- Slack (monitoring + commands) --------------------------------------
# 1. Create an app at https://api.slack.com/apps
# 2. Enable Socket Mode -> generate an App-Level token (xapp-...) with connections:write
# 3. Add a Bot token (xoxb-...) with scopes: app_mentions:read, chat:write,
#    channels:history, groups:history, im:history, im:read, chat:write.public
# 4. Subscribe to bot events: app_mention, message.im
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Channel the fleet posts proactive monitoring alerts to (ID preferred).
# This is the #auria-ops channel in the Auria workspace.
SLACK_ALERT_CHANNEL=C0BKTJWUL9K

# --- Odoo (Auria) -------------------------------------------------------
# Read-only external-API access for odoo-ops, stock-manager and the reorder
# report. Use a DEDICATED bot user, not a personal login.
#
# To generate the API key: log in to Odoo AS THE BOT USER, then top-right
# avatar -> My Profile -> Account Security tab -> New API Key -> name it
# "auria-fleet", enter the bot user's password, and copy the key here.
# (API keys are per-user, so it must be generated while logged in as the bot.)
#
# Verify with:  python3 tools/odoo_check.py
ODOO_URL=https://odoo.auria.global
ODOO_DB=auria
ODOO_USERNAME=bot@auria.global
ODOO_API_KEY=

# --- Monitoring loops ---------------------------------------------------
# How often (seconds) the scheduled monitoring loop runs. 0 disables loops.
AURIA_LOOP_INTERVAL_SECONDS=3600

# --- Daily reports ------------------------------------------------------
# Local wall-clock time (HH:MM) to build the material reorder report and post
# its summary to the Slack alert channel. Leave empty to disable.
AURIA_REORDER_REPORT_TIME=18:00
